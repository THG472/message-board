 7;\n              _this3.publishing = false;\n              return _context3.f(7);\n            case 8:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[4, 6, 7, 8], [0, 2]]);\n      }))();\n    },\n    fetchHotByLike: function fetchHotByLike() {\n      var _this4 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee4() {\n        var _t5;\n        return _regenerator().w(function (_context4) {\n          while (1) switch (_context4.p = _context4.n) {\n            case 0:\n              _this4.loadingLike = true;\n              _context4.p = 1;\n              _context4.n = 2;\n              return getHotByLike(10);\n            case 2:\n              _this4.likeList = _context4.v;\n              _context4.n = 4;\n              break;\n            case 3:\n              _context4.p = 3;\n              _t5 = _context4.v;\n            case 4:\n              _context4.p = 4;\n              _this4.loadingLike = false;\n              return _context4.f(4);\n            case 5:\n              return _context4.a(2);\n          }\n        }, _callee4, null, [[1, 3, 4, 5]]);\n      }))();\n    },\n    fetchHotByComment: function fetchHotByComment() {\n      var _this5 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee5() {\n        var _t6;\n        return _regenerator().w(function (_context5) {\n          while (1) switch (_context5.p = _context5.n) {\n            case 0:\n              _this5.loadingComment = true;\n              _context5.p = 1;\n              _context5.n = 2;\n              return getHotByComment(10);\n            case 2:\n              _this5.commentList = _context5.v;\n              _context5.n = 4;\n              break;\n            case 3:\n              _context5.p = 3;\n              _t6 = _context5.v;\n            case 4:\n              _context5.p = 4;\n              _this5.loadingComment = false;\n              return _context5.f(4);\n            case 5:\n              return _context5.a(2);\n          }\n        }, _callee5, null, [[1, 3, 4, 5]]);\n      }))();\n    },\n    getRankClass: function getRankClass(rank) {\n      if (rank === 1) return 'rank-1';\n      if (rank === 2) return 'rank-2';\n      if (rank === 3) return 'rank-3';\n      return '';\n    }\n  }\n};","map":{"version":3,"names":["getMessageList","publishMessage","toggleLike","getHotByLike","getHotByComment","mapState","name","data","list","loading","pageNum","pageSize","total","activeTab","showPublishDialog","publishing","publishForm","category","title","content","rules","required","message","trigger","likeList","commentList","loadingLike","loadingComment","computed","_objectSpread","created","urlUid","$route","query","uid","$store","commit","fetchList","fetchHotByLike","fetchHotByComment","methods","_this","_asyncToGenerator","_regenerator","m","_callee","res","_t","w","_context","p","n","undefined","v","records","$message","error","f","a","handleTabChange","goDetail","id","$router","push","path","concat","currentUid","handleLike","item","_this2","_callee2","liked","_t2","_context2","warning","likeCount","success","handlePublish","_this3","_callee3","_t3","_t4","_context3","$refs","validate","_this4","_callee4","_t5","_context4","_this5","_callee5","_t6","_context5","getRankClass","rank"],"sources":["src/views/MessageList.vue"],"sourcesContent":["<template>\r\n  <div class=\"message-list-page\">\r\n    <div class=\"main-layout\">\r\n      <!-- 左侧：留言列表 -->\r\n      <div class=\"left-content\">\r\n        <!-- 顶部操作栏 -->\r\n        <div class=\"toolbar\">\r\n          <el-tabs v-model=\"activeTab\" @tab-click=\"handleTabChange\">\r\n            <el-tab-pane label=\"全部\" name=\"\"></el-tab-pane>\r\n            <el-tab-pane label=\"问题反馈\" name=\"question\"></el-tab-pane>\r\n            <el-tab-pane label=\"需求建议\" name=\"requirement\"></el-tab-pane>\r\n          </el-tabs>\r\n          <div class=\"toolbar-actions\">\r\n            <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"showPublishDialog = true\" :disabled=\"!currentUid\">发布留言</el-button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 留言列表 -->\r\n        <div v-loading=\"loading\" class=\"message-list\">\r\n          <el-empty v-if=\"list.length === 0 && !loading\" description=\"暂无留言，快来发布第一条吧\" />\r\n          <el-card\r\n            v-for=\"item in list\"\r\n            :key=\"item.id\"\r\n            class=\"message-card\"\r\n            shadow=\"hover\"\r\n            @click.native=\"goDetail(item.id)\"\r\n          >\r\n            <div class=\"card-header\">\r\n              <el-tag :type=\"item.category === 'question' ? 'danger' : 'success'\" size=\"small\">\r\n                {{ item.category === 'question' ? '问题' : '需求' }}\r\n              </el-tag>\r\n              <span class=\"card-title\">{{ item.title }}</span>\r\n            </div>\r\n            <div class=\"card-content\">{{ item.content }}</div>\r\n            <div class=\"card-footer\">\r\n              <div class=\"footer-left\">\r\n                <span class=\"author\">\r\n                  <i class=\"el-icon-user\"></i> {{ item.userName }}\r\n                  <span v-if=\"item.orgName\" class=\"org\">（{{ item.orgName }}）</span>\r\n                </span>\r\n                <span class=\"time\">{{ item.createTime }}</span>\r\n              </div>\r\n              <div class=\"footer-right\">\r\n                <span class=\"stat\" :class=\"{ 'liked': item.liked }\" @click.stop=\"handleLike(item)\">\r\n                  <i :class=\"item.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"></i> {{ item.likeCount }}\r\n                </span>\r\n                <span class=\"stat\">\r\n                  <i class=\"el-icon-chat-dot-round\"></i> {{ item.commentCount }}\r\n                </span>\r\n              </div>\r\n            </div>\r\n          </el-card>\r\n        </div>\r\n\r\n        <!-- 分页 -->\r\n        <el-pagination\r\n          v-if=\"total > 0\"\r\n          class=\"pagination\"\r\n          background\r\n          layout=\"prev, pager, next\"\r\n          :total=\"total\"\r\n          :page-size=\"pageSize\"\r\n          :current-page.sync=\"pageNum\"\r\n          @current-change=\"fetchList\"\r\n        />\r\n      </div>\r\n\r\n      <!-- 右侧：热榜 -->\r\n      <div class=\"right-sidebar\">\r\n        <!-- 点赞热榜 -->\r\n        <el-card class=\"rank-card\" shadow=\"never\">\r\n          <div slot=\"header\" class=\"rank-header\">\r\n            <i class=\"el-icon-star-on rank-icon like-icon\"></i>\r\n            <span>点赞热榜 TOP 10</span>\r\n          </div>\r\n          <div v-loading=\"loadingLike\" class=\"rank-list\">\r\n            <el-empty v-if=\"likeList.length === 0 && !loadingLike\" description=\"暂无数据\" :image-size=\"50\" />\r\n            <div\r\n              v-for=\"item in likeList\"\r\n              :key=\"'like-' + item.id\"\r\n              class=\"rank-item\"\r\n              @click=\"goDetail(item.id)\"\r\n            >\r\n              <div class=\"rank-num\" :class=\"getRankClass(item.rank)\">\r\n                {{ item.rank }}\r\n              </div>\r\n              <div class=\"rank-info\">\r\n                <div class=\"rank-title\" :title=\"item.title\">{{ item.title }}</div>\r\n                <div class=\"rank-meta\">{{ item.userName }}</div>\r\n              </div>\r\n              <div class=\"rank-count like-count\">\r\n                <i class=\"el-icon-star-on\"></i> {{ item.likeCount }}\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </el-card>\r\n\r\n        <!-- 评论热榜 -->\r\n        <el-card class=\"rank-card\" shadow=\"never\">\r\n          <div slot=\"header\" class=\"rank-header\">\r\n            <i class=\"el-icon-chat-dot-round rank-icon comment-icon\"></i>\r\n            <span>评论热榜 TOP 10</span>\r\n          </div>\r\n          <div v-loading=\"loadingComment\" class=\"rank-list\">\r\n            <el-empty v-if=\"commentList.length === 0 && !loadingComment\" description=\"暂无数据\" :image-size=\"50\" />\r\n            <div\r\n              v-for=\"item in commentList\"\r\n              :key=\"'comment-' + item.id\"\r\n              class=\"rank-item\"\r\n              @click=\"goDetail(item.id)\"\r\n            >\r\n              <div class=\"rank-num\" :class=\"getRankClass(item.rank)\">\r\n                {{ item.rank }}\r\n              </div>\r\n              <div class=\"rank-info\">\r\n                <div class=\"rank-title\" :title=\"item.title\">{{ item.title }}</div>\r\n                <div class=\"rank-meta\">{{ item.userName }}</div>\r\n              </div>\r\n              <div class=\"rank-count comment-count\">\r\n                <i class=\"el-icon-chat-dot-round\"></i> {{ item.commentCount }}\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </el-card>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 发布留言对话框 -->\r\n    <el-dialog title=\"发布留言\" :visible.sync=\"showPublishDialog\" width=\"600px\" :close-on-click-modal=\"false\">\r\n      <el-form ref=\"publishForm\" :model=\"publishForm\" :rules=\"rules\" label-width=\"80px\">\r\n        <el-form-item label=\"分类\" prop=\"category\">\r\n          <el-radio-group v-model=\"publishForm.category\">\r\n            <el-radio label=\"question\">问题反馈</el-radio>\r\n            <el-radio label=\"requirement\">需求建议</el-radio>\r\n          </el-radio-group>\r\n        </el-form-item>\r\n        <el-form-item label=\"标题\" prop=\"title\">\r\n          <el-input v-model=\"publishForm.title\" placeholder=\"请输入标题\" maxlength=\"100\" show-word-limit />\r\n        </el-form-item>\r\n        <el-form-item label=\"内容\" prop=\"content\">\r\n          <el-input v-model=\"publishForm.content\" type=\"textarea\" :rows=\"5\" placeholder=\"请详细描述您的问题或需求\" maxlength=\"2000\" show-word-limit />\r\n        </el-form-item>\r\n      </el-form>\r\n      <span slot=\"footer\">\r\n        <el-button @click=\"showPublishDialog = false\">取消</el-button>\r\n        <el-button type=\"primary\" @click=\"handlePublish\" :loading=\"publishing\">发布</el-button>\r\n      </span>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMessageList, publishMessage, toggleLike, getHotByLike, getHotByComment } from '../api'\r\nimport { mapState } from 'vuex'\r\n\r\nexport default {\r\n  name: 'MessageList',\r\n  data() {\r\n    return {\r\n      list: [],\r\n      loading: false,\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      activeTab: '',\r\n      showPublishDialog: false,\r\n      publishing: false,\r\n      publishForm: {\r\n        category: 'question',\r\n        title: '',\r\n        content: ''\r\n      },\r\n      rules: {\r\n        category: [{ required: true, message: '请选择分类', trigger: 'change' }],\r\n        title: [{ required: true, message: '请输入标题', trigger: 'blur' }],\r\n        content: [{ required: true, message: '请输入内容', trigger: 'blur' }]\r\n      },\r\n      likeList: [],\r\n      commentList: [],\r\n      loadingLike: false,\r\n      loadingComment: false\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState(['currentUid'])\r\n  },\r\n  created() {\r\n    const urlUid = this.$route.query.uid\r\n    if (urlUid) {\r\n      this.$store.commit('SET_UID', urlUid)\r\n    }\r\n    this.fetchList()\r\n    this.fetchHotByLike()\r\n    this.fetchHotByComment()\r\n  },\r\n  methods: {\r\n    async fetchList() {\r\n      this.loading = true\r\n      try {\r\n        const res = await getMessageList({\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          category: this.activeTab || undefined\r\n        })\r\n        this.list = res.records || []\r\n        this.total = res.total || 0\r\n      } catch (e) {\r\n        this.$message.error('加载留言列表失败')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    handleTabChange() {\r\n      this.pageNum = 1\r\n      this.fetchList()\r\n    },\r\n    goDetail(id) {\r\n      this.$router.push({ path: `/detail/${id}`, query: { uid: this.currentUid } })\r\n    },\r\n    async handleLike(item) {\r\n      if (!this.currentUid) {\r\n        this.$message.warning('请通过正确的链接访问系统')\r\n        return\r\n      }\r\n      try {\r\n        const liked = await toggleLike(item.id)\r\n        item.liked = liked\r\n        item.likeCount += liked ? 1 : -1\r\n        this.$message.success(liked ? '点赞成功' : '已取消点赞')\r\n        // 刷新热榜\r\n        this.fetchHotByLike()\r\n      } catch (e) {\r\n        this.$message.error('操作失败')\r\n      }\r\n    },\r\n    async handlePublish() {\r\n      try {\r\n        await this.$refs.publishForm.validate()\r\n      } catch {\r\n        return\r\n      }\r\n      this.publishing = true\r\n      try {\r\n        await publishMessage(this.publishForm)\r\n        this.$message.success('发布成功')\r\n        this.showPublishDialog = false\r\n        this.publishForm = { category: 'question', title: '', content: '' }\r\n        this.pageNum = 1\r\n        this.fetchList()\r\n      } catch (e) {\r\n        this.$message.error(e.message || '发布失败')\r\n      } finally {\r\n        this.publishing = false\r\n      }\r\n    },\r\n    async fetchHotByLike() {\r\n      this.loadingLike = true\r\n      try {\r\n        this.likeList = await getHotByLike(10)\r\n      } catch (e) {\r\n        // 静默失败\r\n      } finally {\r\n        this.loadingLike = false\r\n      }\r\n    },\r\n    async fetchHotByComment() {\r\n      this.loadingComment = true\r\n      try {\r\n        this.commentList = await getHotByComment(10)\r\n      } catch (e) {\r\n        // 静默失败\r\n      } finally {\r\n        this.loadingComment = false\r\n      }\r\n    },\r\n    getRankClass(rank) {\r\n      if (rank === 1) return 'rank-1'\r\n      if (rank === 2) return 'rank-2'\r\n      if (rank === 3) return 'rank-3'\r\n      return ''\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.message-list-page {\r\n  padding: 0;\r\n}\r\n.main-layout {\r\n  display: flex;\r\n  gap: 32px;\r\n}\r\n.left-content {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n.right-sidebar {\r\n  width: 320px;\r\n  flex-shrink: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\r\n.toolbar {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  background: #fff;\r\n  padding: 0 24px;\r\n  border-radius: 8px;\r\n  margin-bottom: 20px;\r\n  box-shadow: 0 1px 4px rgba(0,0,0,0.06);\r\n}\r\n.toolbar ::v-deep .el-tabs__header {\r\n  margin-bottom: 0;\r\n}\r\n.toolbar-actions {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n.message-card {\r\n  margin-bottom: 12px;\r\n  cursor: pointer;\r\n  border-radius: 8px;\r\n  transition: transform 0.2s;\r\n}\r\n.message-card:hover {\r\n  transform: translateY(-2px);\r\n}\r\n.card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  margin-bottom: 12px;\r\n}\r\n.card-title {\r\n  font-size: 17px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n}\r\n.card-content {\r\n  color: #606266;\r\n  font-size: 14px;\r\n  line-height: 1.8;\r\n  margin-bottom: 16px;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n.card-footer {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 14px;\r\n  color: #909399;\r\n  border-top: 1px solid #f0f0f0;\r\n  padding-top: 12px;\r\n}\r\n.footer-left {\r\n  display: flex;\r\n  gap: 20px;\r\n}\r\n.footer-right {\r\n  display: flex;\r\n  gap: 24px;\r\n}\r\n.stat {\r\n  cursor: pointer;\r\n  user-select: none;\r\n}\r\n.stat:hover {\r\n  color: #409EFF;\r\n}\r\n.stat.liked {\r\n  color: #f56c6c;\r\n}\r\n.org {\r\n  color: #909399;\r\n}\r\n.pagination {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n}\r\n\r\n/* 热榜样式 */\r\n.rank-card {\r\n  border-radius: 8px;\r\n}\r\n.rank-header {\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.rank-icon {\r\