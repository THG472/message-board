el-icon-star-on rank-icon like-icon\"></i>\r\n          <span>点赞热榜 TOP 10</span>\r\n        </div>\r\n        <div v-loading=\"loadingLike\">\r\n          <el-empty v-if=\"likeList.length === 0 && !loadingLike\" description=\"暂无数据\" />\r\n          <div v-for=\"item in likeList\" :key=\"item.id\" class=\"rank-item\" @click=\"goDetail(item.id)\">\r\n            <div class=\"rank-num\" :class=\"getRankClass(item.rank)\">\r\n              <template v-if=\"item.rank <= 3\">\r\n                <i class=\"el-icon-medal\"></i>\r\n              </template>\r\n              {{ item.rank }}\r\n            </div>\r\n            <div class=\"rank-info\">\r\n              <div class=\"rank-title\">\r\n                <el-tag :type=\"item.category === 'question' ? 'danger' : 'success'\" size=\"mini\">\r\n                  {{ item.category === 'question' ? '问题' : '需求' }}\r\n                </el-tag>\r\n                {{ item.title }}\r\n              </div>\r\n              <div class=\"rank-meta\">\r\n                {{ item.userName }}\r\n                <span v-if=\"item.orgName\">（{{ item.orgName }}）</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"rank-count\">\r\n              <i class=\"el-icon-star-on\"></i> {{ item.likeCount }}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </el-card>\r\n\r\n      <!-- 评论热榜 -->\r\n      <el-card class=\"rank-card\" shadow=\"never\">\r\n        <div slot=\"header\" class=\"rank-header\">\r\n          <i class=\"el-icon-chat-dot-round rank-icon comment-icon\"></i>\r\n          <span>评论热榜 TOP 10</span>\r\n        </div>\r\n        <div v-loading=\"loadingComment\">\r\n          <el-empty v-if=\"commentList.length === 0 && !loadingComment\" description=\"暂无数据\" />\r\n          <div v-for=\"item in commentList\" :key=\"item.id\" class=\"rank-item\" @click=\"goDetail(item.id)\">\r\n            <div class=\"rank-num\" :class=\"getRankClass(item.rank)\">\r\n              <template v-if=\"item.rank <= 3\">\r\n                <i class=\"el-icon-medal\"></i>\r\n              </template>\r\n              {{ item.rank }}\r\n            </div>\r\n            <div class=\"rank-info\">\r\n              <div class=\"rank-title\">\r\n                <el-tag :type=\"item.category === 'question' ? 'danger' : 'success'\" size=\"mini\">\r\n                  {{ item.category === 'question' ? '问题' : '需求' }}\r\n                </el-tag>\r\n                {{ item.title }}\r\n              </div>\r\n              <div class=\"rank-meta\">\r\n                {{ item.userName }}\r\n                <span v-if=\"item.orgName\">（{{ item.orgName }}）</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"rank-count\">\r\n              <i class=\"el-icon-chat-dot-round\"></i> {{ item.commentCount }}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getHotByLike, getHotByComment } from '../api'\r\n\r\nexport default {\r\n  name: 'HotRank',\r\n  data() {\r\n    return {\r\n      likeList: [],\r\n      commentList: [],\r\n      loadingLike: false,\r\n      loadingComment: false\r\n    }\r\n  },\r\n  created() {\r\n    this.fetchHotByLike()\r\n    this.fetchHotByComment()\r\n  },\r\n  methods: {\r\n    async fetchHotByLike() {\r\n      this.loadingLike = true\r\n      try {\r\n        this.likeList = await getHotByLike(10)\r\n      } catch (e) {\r\n        this.$message.error('加载点赞热榜失败')\r\n      } finally {\r\n        this.loadingLike = false\r\n      }\r\n    },\r\n    async fetchHotByComment() {\r\n      this.loadingComment = true\r\n      try {\r\n        this.commentList = await getHotByComment(10)\r\n      } catch (e) {\r\n        this.$message.error('加载评论热榜失败')\r\n      } finally {\r\n        this.loadingComment = false\r\n      }\r\n    },\r\n    getRankClass(rank) {\r\n      if (rank === 1) return 'rank-1'\r\n      if (rank === 2) return 'rank-2'\r\n      if (rank === 3) return 'rank-3'\r\n      return ''\r\n    },\r\n    goDetail(id) {\r\n      this.$router.push({ path: `/detail/${id}`, query: { uid: this.$store.state.currentUid } })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.hot-rank-page {\r\n  max-width: 1100px;\r\n  margin: 0 auto;\r\n}\r\n.back-btn {\r\n  margin-bottom: 16px;\r\n}\r\n.rank-container {\r\n  display: flex;\r\n  gap: 20px;\r\n}\r\n.rank-card {\r\n  flex: 1;\r\n  border-radius: 8px;\r\n}\r\n.rank-header {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.rank-icon {\r\n  font-size: 20px;\r\n}\r\n.like-icon {\r\n  color: #f56c6c;\r\n}\r\n.comment-icon {\r\n  color: #409EFF;\r\n}\r\n.rank-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 12px 0;\r\n  border-bottom: 1px solid #f5f5f5;\r\n  cursor: pointer;\r\n  transition: background 0.2s;\r\n}\r\n.rank-item:hover {\r\n  background: #fafafa;\r\n}\r\n.rank-item:last-child {\r\n  border-bottom: none;\r\n}\r\n.rank-num {\r\n  width: 40px;\r\n  text-align: center;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  color: #909399;\r\n  flex-shrink: 0;\r\n}\r\n.rank-num.rank-1 {\r\n  color: #f56c6c;\r\n  font-size: 22px;\r\n}\r\n.rank-num.rank-2 {\r\n  color: #e6a23c;\r\n  font-size: 20px;\r\n}\r\n.rank-num.rank-3 {\r\n  color: #67c23a;\r\n  font-size: 18px;\r\n}\r\n.rank-info {\r\n  flex: 1;\r\n  padding: 0 12px;\r\n}\r\n.rank-title {\r\n  font-size: 14px;\r\n  color: #303133;\r\n  margin-bottom: 4px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n.rank-meta {\r\n  font-size: 12px;\r\n  color: #909399;\r\n}\r\n.rank-count {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #409EFF;\r\n  flex-shrink: 0;\r\n  min-width: 60px;\r\n  text-align: right;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .rank-container {\r\n    flex-direction: column;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;;AA6EA,SAAAA,YAAA,EAAAC,eAAA;AAEA;EACAC,IAA