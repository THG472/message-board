ext3.a(2);\n            case 1:\n              _this3.submitting = true;\n              _context3.p = 2;\n              _context3.n = 3;\n              return publishComment({\n                messageId: _this3.message.id,\n                content: _this3.commentContent,\n                parentId: null\n              });\n            case 3:\n              _this3.$message.success('评论成功');\n              _this3.commentContent = '';\n              _this3.fetchDetail();\n              _context3.n = 5;\n              break;\n            case 4:\n              _context3.p = 4;\n              _t3 = _context3.v;\n              _this3.$message.error(_t3.message || '评论失败');\n            case 5:\n              _context3.p = 5;\n              _this3.submitting = false;\n              return _context3.f(5);\n            case 6:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[2, 4, 5, 6]]);\n      }))();\n    },\n    openReply: function openReply(comment, reply) {\n      this.replyTarget = reply || comment;\n      this.replyContent = '';\n      this.$nextTick(function () {\n        var box = document.querySelector('.reply-editor textarea');\n        if (box) box.focus();\n      });\n    },\n    submitReply: function submitReply(comment) {\n      var _this4 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee4() {\n        var _t4;\n        return _regenerator().w(function (_context4) {\n          while (1) switch (_context4.p = _context4.n) {\n            case 0:\n              if (_this4.replyContent.trim()) {\n                _context4.n = 1;\n                break;\n              }\n              return _context4.a(2);\n            case 1:\n              _this4.submitting = true;\n              _context4.p = 2;\n              _context4.n = 3;\n              return publishComment({\n                messageId: _this4.message.id,\n                content: _this4.replyContent,\n                parentId: comment.id,\n                replyToUid: _this4.replyTarget ? _this4.replyTarget.uid : comment.uid\n              });\n            case 3:\n              _this4.$message.success('回复成功');\n              _this4.replyTarget = null;\n              _this4.replyContent = '';\n              _this4.fetchDetail();\n              _context4.n = 5;\n              break;\n            case 4:\n              _context4.p = 4;\n              _t4 = _context4.v;\n              _this4.$message.error(_t4.message || '回复失败');\n            case 5:\n              _context4.p = 5;\n              _this4.submitting = false;\n              return _context4.f(5);\n            case 6:\n              return _context4.a(2);\n          }\n        }, _callee4, null, [[2, 4, 5, 6]]);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["getMessageDetail","toggleLike","publishComment","mapState","name","data","message","loading","commentContent","replyTarget","replyContent","submitting","computed","_objectSpread","created","fetchDetail","methods","_this","_asyncToGenerator","_regenerator","m","_callee","_t","w","_context","p","n","$route","params","id","v","$message","error","f","a","scrollToComment","box","$refs","commentBox","scrollIntoView","behavior","block","$nextTick","textarea","querySelector","focus","handleLike","_this2","_callee2","liked","_t2","_context2","currentUid","warning","likeCount","submitComment","_this3","_callee3","_t3","_context3","trim","messageId","content","parentId","success","openReply","comment","reply","document","submitReply","_this4","_callee4","_t4","_context4","replyToUid","uid"],"sources":["src/views/MessageDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"detail-page\">\r\n    <div class=\"detail-breadcrumb\">\r\n      <el-button icon=\"el-icon-arrow-left\" @click=\"$router.push('/')\" size=\"medium\" plain>返回留言列表</el-button>\r\n    </div>\r\n\r\n    <div v-loading=\"loading\" class=\"detail-layout\" element-loading-text=\"加载中...\">\r\n      <!-- 左侧主内容区 -->\r\n      <div class=\"detail-main\">\r\n        <!-- 留言详情卡片 -->\r\n        <div class=\"detail-card\">\r\n          <div class=\"card-label\" :class=\"message.category\">\r\n            {{ message.category === 'question' ? '问题反馈' : '需求建议' }}\r\n          </div>\r\n          <h1 class=\"detail-title\">{{ message.title }}</h1>\r\n          <div class=\"detail-meta\">\r\n            <div class=\"meta-author\">\r\n              <span class=\"meta-avatar\">{{ message.userName ? message.userName.charAt(0) : '?' }}</span>\r\n              <div class=\"meta-author-info\">\r\n                <div class=\"meta-name\">{{ message.userName }}</div>\r\n                <div class=\"meta-org\" v-if=\"message.orgName\">{{ message.orgName }}</div>\r\n              </div>\r\n            </div>\r\n            <div class=\"meta-right\">\r\n              <span class=\"meta-time\"><i class=\"el-icon-time\"></i> {{ message.createTime }}</span>\r\n            </div>\r\n          </div>\r\n          <div class=\"detail-body\">{{ message.content }}</div>\r\n          <div class=\"detail-actions\">\r\n            <div class=\"action-item\" :class=\"{ liked: message.liked }\" @click=\"handleLike\">\r\n              <div class=\"action-icon-box\" :class=\"{ liked: message.liked }\">\r\n                <i :class=\"message.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\r\n              </div>\r\n              <div class=\"action-info\">\r\n                <div class=\"action-num\">{{ message.likeCount }}</div>\r\n                <div class=\"action-label\">{{ message.liked ? '已点赞' : '点赞' }}</div>\r\n              </div>\r\n            </div>\r\n            <div class=\"action-item\" @click=\"scrollToComment\">\r\n              <div class=\"action-icon-box\">\r\n                <i class=\"el-icon-chat-dot-round\"></i>\r\n              </div>\r\n              <div class=\"action-info\">\r\n                <div class=\"action-num\">{{ message.commentCount }}</div>\r\n                <div class=\"action-label\">评论</div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 评论区 -->\r\n        <div class=\"comment-section\" ref=\"commentBox\">\r\n          <div class=\"section-header\">\r\n            <h3>\r\n              <i class=\"el-icon-chat-line-square\"></i>\r\n              评论交流\r\n              <span class=\"badge\">{{ message.commentCount }}</span>\r\n            </h3>\r\n          </div>\r\n\r\n          <!-- 评论输入 -->\r\n          <div class=\"comment-editor\">\r\n            <div class=\"editor-avatar\">{{ message.userName ? message.userName.charAt(0) : '?' }}</div>\r\n            <div class=\"editor-body\">\r\n              <el-input\r\n                v-model=\"commentContent\"\r\n                type=\"textarea\"\r\n                :rows=\"3\"\r\n                placeholder=\"写下你的想法，和作者交流...\"\r\n                resize=\"none\"\r\n                class=\"editor-input\"\r\n              />\r\n              <div class=\"editor-footer\">\r\n                <span class=\"editor-hint\">💡 支持友善交流，文明发言</span>\r\n                <el-button\r\n                  type=\"primary\"\r\n                  @click=\"submitComment\"\r\n                  :loading=\"submitting\"\r\n                  :disabled=\"!commentContent.trim()\"\r\n                  size=\"medium\"\r\n                >\r\n                  发表评论\r\n                </el-button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 评论列表 -->\r\n          <div class=\"comment-list\">\r\n            <el-empty\r\n              v-if=\"!loading && (!message.comments || message.comments.length === 0)\"\r\n              description=\"还没有评论，快来发表第一条评论吧\"\r\n              :image-size=\"100\"\r\n            />\r\n            <div v-for=\"comment in message.comments\" :key=\"comment.id\" class=\"comment-card\">\r\n              <div class=\"comment-main\">\r\n                <div class=\"cmt-avatar\">{{ comment.userName ? comment.userName.charAt(0) : '?' }}</div>\r\n                <div class=\"cmt-body\">\r\n                  <div class=\"cmt-header\">\r\n                    <span class=\"cmt-name\">{{ comment.userName }}</span>\r\n                    <span v-if=\"comment.orgName\" class=\"cmt-org\">{{ comment.orgName }}</span>\r\n                    <span class=\"cmt-time\">{{ comment.createTime }}</span>\r\n                  </div>\r\n                  <div class=\"cmt-text\">{{ comment.content }}</div>\r\n                  <div class=\"cmt-footer\">\r\n                    <span class=\"cmt-reply-btn\" @click=\"openReply(comment)\">\r\n                      <i class=\"el-icon-chat-line-square\"></i> 回复\r\n                    </span>\r\n                  </div>\r\n\r\n                  <!-- 回复输入框 -->\r\n                  <div v-if=\"replyTarget && replyTarget.id === comment.id\" class=\"reply-editor\">\r\n                    <el-input\r\n                      v-model=\"replyContent\"\r\n                      type=\"textarea\"\r\n                      :rows=\"2\"\r\n                      :placeholder=\"'回复 @' + comment.userName + '...'\"\r\n                      resize=\"none\"\r\n                    />\r\n                    <div class=\"reply-editor-footer\">\r\n                      <span class=\"reply-hint\">回复 @{{ comment.userName }}</span>\r\n                      <div class=\"reply-btns\">\r\n                        <el-button size=\"small\" @click=\"replyTarget = null\">取消</el-button>\r\n                        <el-button type=\"primary\" size=\"small\" @click=\"submitReply(comment)\" :loading=\"submitting\">回复</el-button>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n\r\n              <!-- 子回复 -->\r\n              <div v-if=\"comment.replies && comment.replies.length > 0\" class=\"sub-comments\">\r\n                <div v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"sub-item\">\r\n                  <span class=\"sub-avatar\">{{ reply.userName ? reply.userName.charAt(0) : '?' }}</span>\r\n                  <div class=\"sub-body\">\r\n                    <div class=\"sub-header\">\r\n                      <span class=\"sub-name\">{{ reply.userName }}</span>\r\n                      <span v-if=\"reply.replyToName\" class=\"sub-reply-to\">\r\n                        <i class=\"el-icon-d-arrow-right\"></i> {{ reply.replyToName }}\r\n                      </span>\r\n                      <span class=\"sub-time\">{{ reply.createTime }}</span>\r\n                    </div>\r\n                    <div class=\"sub-text\">{{ reply.content }}</div>\r\n                    <span class=\"cmt-reply-btn\" @click=\"openReply(comment, reply)\">\r\n                      <i class=\"el-icon-chat-line-square\"></i> 回复\r\n                    </span>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 右侧信息栏 -->\r\n      <div class=\"detail-sidebar\">\r\n        <!-- 发布者信息 -->\r\n        <div class=\"sidebar-card\">\r\n          <div class=\"sidebar-card-title\">发布者</div>\r\n          <div class=\"publisher-info\">\r\n            <div class=\"publisher-avatar\">{{ message.userName ? message.userName.charAt(0) : '?' }}</div>\r\n            <div class=\"publisher-name\">{{ message.userName }}</div>\r\n            <div class=\"publisher-org\" v-if=\"message.orgName\">{{ message.orgName }}</div>\r\n          </div>\r\n          <div class=\"publisher-stats\">\r\n            <div class=\"pub-stat\">\r\n              <div class=\"pub-stat-num\">{{ message.likeCount }}</div>\r\n              <div class=\"pub-stat-label\">获赞</div>\r\n            </div>\r\n            <div class=\"pub-stat-divider\"></div>\r\n            <div class=\"pub-stat\">\r\n              <div class=\"pub-stat-num\">{{ message.commentCount }}</div>\r\n              <div class=\"pub-stat-label\">评论</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 留言信息 -->\r\n        <div class=\"sidebar-card\">\r\n          <div class=\"sidebar-card-title\">留言信息</div>\r\n          <div class=\"info-list\">\r\n            <div class=\"info-item\">\r\n              <span class=\"info-label\">分类</span>\r\n              <span class=\"info-value\">\r\n                <span class=\"info-tag\" :class=\"message.category\">\r\n                  {{ message.category === 'question' ? '问题反馈' : '需求建议' }}\r\n                </span>\r\n              </span>\r\n            </div>\r\n            <div class=\"info-item\">\r\n              <span class=\"info-label\">发布时间</span>\r\n              <span class=\"info-value\">{{ message.createTime }}</span>\r\n            </div>\r\n            <div class=\"info-item\">\r\n              <span class=\"info-label\">最后更新</span>\r\n              <span class=\"info-value\">{{ message.updateTime }}</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMessageDetail, toggleLike, publishComment } from '../api'\r\nimport { mapState } from 'vuex'\r\n\r\nexport default {\r\n  name: 'MessageDetail',\r\n  data() {\r\n    return {\r\n      message: {},\r\n      loading: false,\r\n      commentContent: '',\r\n      replyTarget: null,\r\n      replyContent: '',\r\n      submitting: false\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState(['currentUid'])\r\n  },\r\n  created() {\r\n    this.fetchDetail()\r\n  },\r\n  methods: {\r\n    async fetchDetail() {\r\n      this.loading = true\r\n      try {\r\n        this.message = await getMessageDetail(this.$route.params.id)\r\n      } catch (e) {\r\n        this.$message.error('加载详情失败')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    scrollToComment() {\r\n      const box = this.$refs.commentBox\r\n      if (box) {\r\n        box.scrollIntoView({ behavior: 'smooth', block: 'start' })\r\n        this.$nextTick(() => {\r\n          const textarea = box.querySelector('textarea')\r\n          if (textarea) textarea.focus()\r\n        })\r\n      }\r\n    },\r\n    async handleLike() {\r\n      if (!this.currentUid) {\r\n        this.$message.warning('请通过正确的链接访问系统')\r\n        return\r\n      }\r\n      try {\r\n        const liked = await toggleLike(this.message.id)\r\n        this.message.liked = liked\r\n        this.message.likeCount += liked ? 1 : -1\r\n      } catch (e) {\r\n        this.$message.error('操作失败')\r\n      }\r\n    },\r\n    async submitComment() {\r\n      if (!this.commentContent.trim()) return\r\n      this.submitting = true\r\n      try {\r\n        await publishComment({\r\n          messageId: this.message.id,\r\n          content: this.commentContent,\r\n          parentId: null\r\n        })\r\n        this.$message.success('评论成功')\r\n        this.commentContent = ''\r\n        this.fetchDetail()\r\n      } catch (e) {\r\n        this.$message.error(e.message || '评论失败')\r\n      } finally {\r\n        this.submitting = false\r\n      }\r\n    },\r\n    openReply(comment, reply) {\r\n      this.replyTarget = reply || comment\r\n      this.replyContent = ''\r\n      this.$nextTick(() => {\r\n        const box = document.querySelector('.reply-editor textarea')\r\n        if (box) box.focus()\r\n      })\r\n    },\r\n    async submitReply(comment) {\r\n      if (!this.replyContent.trim()) return\r\n      this.submitting = true\r\n      try {\r\n        await publishComment({\r\n          messageId: this.message.id,\r\n          content: this.replyContent,\r\n          parentId: comment.id,\r\n          replyToUid: this.replyTarget ? this.replyTarget.uid : comment.uid\r\n        })\r\n        this.$message.success('回复成功')\r\n        this.replyTarget = null\r\n        this.replyContent = ''\r\n        this.fetchDetail()\r\n      } catch (e) {\r\n        this.$message.error(e.message || '回复失败')\r\n      } finally {\r\n        this.submitting = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.detail-page {\r\n  max-width: 100%;\r\n}\r\n\r\n/* ========== 面包屑 ========== */\r\n.detail-breadcrumb {\r\n  margin-bottom: 24px;\r\n}\r\n\r\n/* ========== 主布局 ========== */\r\n.detail-layout {\r\n  display: flex;\r\n  gap: 24px;\r\n  align-items: flex-start;\r\n}\r\n.detail-main {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n.detail-sidebar {\r\n  width: 280px;\r\n  flex-shrink: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n  position: sticky;\r\n  top: 84px;\r\n}\r\n\r\n/* ========== 详情卡片 ========== */\r\n.detail-card {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  padding: 36px 40px;\r\n  margin-bottom: 24px;\r\n  box-shadow: 0 2px 12px rgba(0,0,0,0.04);\r\n}\r\n.card-label {\r\n  display: inline-block;\r\n  padding: 5px 16px;\r\n  border-radius: 4px;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  margin-bottom: 18px;\r\n}\r\n.card-label.question {\r\n  background: #fef0f0;\r\n  color: #f56c6c;\r\n}\r\n.card-label.requirement {\r\n  background: #f0f9eb;\r\n  color: #67c23a;\r\n}\r\n.detail-title {\r\n  font-size: 26px;\r\n  font-weight: 700;\r\n  color: #1d2129;\r\n  line-height: 1.45;\r\n  margin-bottom: 20px;\r\n}\r\n.detail-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding-bottom: 24px;\r\n  margin-bottom: 28px;\r\n  border-bottom: 1px solid #f2f3f5;\r\n}\r\n.meta-author {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n.meta-avatar {\r\n  width: 42px;\r\n  height: 42px;\r\n  border-radius: 50%;\r\n  background: linear-gradient(135deg, #409EFF, #337ECC);\r\n  color: #fff;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 17px;\r\n  font-weight: 700;\r\n  flex-shrink: 0;\r\n}\r\n.meta-name {\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  color: #1d2129;\r\n}\r\n.me