 case 1:\n              if (_this4.replyContent.trim()) {\n                _context4.n = 2;\n                break;\n              }\n              _this4.$message.warning('请输入回复内容');\n              return _context4.a(2);\n            case 2:\n              _this4.submitting = true;\n              _context4.p = 3;\n              _context4.n = 4;\n              return publishComment({\n                messageId: _this4.message.id,\n                content: _this4.replyContent,\n                uid: uid,\n                parentId: comment.id,\n                replyToUid: _this4.replyTarget ? _this4.replyTarget.uid : comment.uid\n              });\n            case 4:\n              _this4.$message.success('回复成功');\n              _this4.replyTarget = null;\n              _this4.replyContent = '';\n              _this4.$store.commit('SET_UID', uid);\n              _this4.fetchDetail();\n              _context4.n = 6;\n              break;\n            case 5:\n              _context4.p = 5;\n              _t4 = _context4.v;\n              _this4.$message.error(_t4.message || '回复失败');\n            case 6:\n              _context4.p = 6;\n              _this4.submitting = false;\n              return _context4.f(6);\n            case 7:\n              return _context4.a(2);\n          }\n        }, _callee4, null, [[3, 5, 6, 7]]);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["getMessageDetail","toggleLike","publishComment","mapState","name","data","message","loading","showCommentInput","commentContent","commentUid","replyTarget","replyContent","submitting","computed","_objectSpread","created","fetchDetail","methods","_this","_asyncToGenerator","_regenerator","m","_callee","uid","_t","w","_context","p","n","currentUid","$route","query","params","id","v","$message","error","f","a","handleLike","_this2","_callee2","liked","_t2","_context2","warning","likeCount","success","submitComment","_this3","_callee3","_t3","_context3","trim","messageId","content","parentId","$store","commit","openReply","comment","reply","submitReply","_this4","_callee4","_t4","_context4","replyToUid"],"sources":["src/views/MessageDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"detail-page\">\r\n    <el-button icon=\"el-icon-back\" @click=\"$router.back()\" class=\"back-btn\">返回列表</el-button>\r\n\r\n    <el-card v-loading=\"loading\" class=\"detail-card\" shadow=\"never\">\r\n      <!-- 留言详情 -->\r\n      <div class=\"detail-header\">\r\n        <el-tag :type=\"message.category === 'question' ? 'danger' : 'success'\" size=\"small\">\r\n          {{ message.category === 'question' ? '问题反馈' : '需求建议' }}\r\n        </el-tag>\r\n        <h2 class=\"detail-title\">{{ message.title }}</h2>\r\n      </div>\r\n      <div class=\"detail-meta\">\r\n        <span><i class=\"el-icon-user\"></i> {{ message.userName }}</span>\r\n        <span v-if=\"message.orgName\">（{{ message.orgName }}）</span>\r\n        <span class=\"meta-divider\">|</span>\r\n        <span>{{ message.createTime }}</span>\r\n      </div>\r\n      <div class=\"detail-content\">{{ message.content }}</div>\r\n      <div class=\"detail-actions\">\r\n        <el-button\r\n          :type=\"message.liked ? 'danger' : 'default'\"\r\n          :icon=\"message.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"\r\n          size=\"small\"\r\n          @click=\"handleLike\"\r\n        >\r\n          点赞 {{ message.likeCount }}\r\n        </el-button>\r\n        <el-button type=\"primary\" icon=\"el-icon-edit\" size=\"small\" @click=\"showCommentInput = true\">\r\n          评论 {{ message.commentCount }}\r\n        </el-button>\r\n      </div>\r\n    </el-card>\r\n\r\n    <!-- 评论输入框 -->\r\n    <div v-if=\"showCommentInput\" class=\"comment-input-box\">\r\n      <el-input\r\n        v-model=\"commentContent\"\r\n        type=\"textarea\"\r\n        :rows=\"3\"\r\n        placeholder=\"写下你的评论...\"\r\n      />\r\n      <div class=\"comment-input-actions\">\r\n        <span class=\"tip\" v-if=\"!currentUid\">\r\n          <el-input v-model=\"commentUid\" placeholder=\"请输入UID\" size=\"small\" style=\"width: 150px;\" />\r\n        </span>\r\n        <el-button @click=\"showCommentInput = false\">取消</el-button>\r\n        <el-button type=\"primary\" @click=\"submitComment\" :loading=\"submitting\">发表评论</el-button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 评论列表 -->\r\n    <div class=\"comment-section\">\r\n      <h3 v-if=\"message.comments && message.comments.length > 0\">评论 ({{ message.commentCount }})</h3>\r\n      <div v-for=\"comment in message.comments\" :key=\"comment.id\" class=\"comment-item\">\r\n        <div class=\"comment-avatar\">{{ comment.userName.charAt(0) }}</div>\r\n        <div class=\"comment-body\">\r\n          <div class=\"comment-user\">\r\n            <strong>{{ comment.userName }}</strong>\r\n            <span v-if=\"comment.orgName\" class=\"org\">（{{ comment.orgName }}）</span>\r\n            <span class=\"comment-time\">{{ comment.createTime }}</span>\r\n          </div>\r\n          <div class=\"comment-text\">{{ comment.content }}</div>\r\n          <div class=\"comment-reply-btn\">\r\n            <el-button type=\"text\" size=\"mini\" @click=\"openReply(comment)\">回复</el-button>\r\n          </div>\r\n          <!-- 回复输入框 -->\r\n          <div v-if=\"replyTarget && replyTarget.id === comment.id\" class=\"reply-input-box\">\r\n            <el-input\r\n              v-model=\"replyContent\"\r\n              type=\"textarea\"\r\n              :rows=\"2\"\r\n              :placeholder=\"'回复 ' + comment.userName\"\r\n            />\r\n            <div class=\"reply-actions\">\r\n              <el-button size=\"mini\" @click=\"replyTarget = null\">取消</el-button>\r\n              <el-button type=\"primary\" size=\"mini\" @click=\"submitReply(comment)\" :loading=\"submitting\">回复</el-button>\r\n            </div>\r\n          </div>\r\n          <!-- 子回复 -->\r\n          <div v-if=\"comment.replies && comment.replies.length > 0\" class=\"sub-comments\">\r\n            <div v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"sub-comment-item\">\r\n              <span class=\"reply-avatar\">{{ reply.userName.charAt(0) }}</span>\r\n              <div class=\"sub-comment-body\">\r\n                <span class=\"sub-comment-user\">\r\n                  <strong>{{ reply.userName }}</strong>\r\n                  <span v-if=\"reply.replyToName\" class=\"reply-to\">\r\n                    回复 <strong>{{ reply.replyToName }}</strong>\r\n                  </span>\r\n                </span>\r\n                <span class=\"comment-time\">{{ reply.createTime }}</span>\r\n                <div class=\"comment-text\">{{ reply.content }}</div>\r\n                <el-button type=\"text\" size=\"mini\" @click=\"openReply(comment, reply)\">回复</el-button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <el-empty v-if=\"!loading && (!message.comments || message.comments.length === 0)\" description=\"暂无评论\" />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMessageDetail, toggleLike, publishComment } from '../api'\r\nimport { mapState } from 'vuex'\r\n\r\nexport default {\r\n  name: 'MessageDetail',\r\n  data() {\r\n    return {\r\n      message: {},\r\n      loading: false,\r\n      showCommentInput: false,\r\n      commentContent: '',\r\n      commentUid: '',\r\n      replyTarget: null,\r\n      replyContent: '',\r\n      submitting: false\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState(['currentUid'])\r\n  },\r\n  created() {\r\n    this.fetchDetail()\r\n  },\r\n  methods: {\r\n    async fetchDetail() {\r\n      this.loading = true\r\n      try {\r\n        const uid = this.currentUid || this.$route.query.uid || ''\r\n        this.message = await getMessageDetail(this.$route.params.id, uid)\r\n      } catch (e) {\r\n        this.$message.error('加载详情失败')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async handleLike() {\r\n      const uid = this.currentUid || this.commentUid\r\n      if (!uid) {\r\n        this.$message.warning('请先输入用户UID')\r\n        return\r\n      }\r\n      try {\r\n        const liked = await toggleLike(this.message.id, uid)\r\n        this.message.liked = liked\r\n        this.message.likeCount += liked ? 1 : -1\r\n        this.$message.success(liked ? '点赞成功' : '已取消点赞')\r\n      } catch (e) {\r\n        this.$message.error('操作失败')\r\n      }\r\n    },\r\n    async submitComment() {\r\n      const uid = this.currentUid || this.commentUid\r\n      if (!uid) {\r\n        this.$message.warning('请输入用户UID')\r\n        return\r\n      }\r\n      if (!this.commentContent.trim()) {\r\n        this.$message.warning('请输入评论内容')\r\n        return\r\n      }\r\n      this.submitting = true\r\n      try {\r\n        await publishComment({\r\n          messageId: this.message.id,\r\n          content: this.commentContent,\r\n          uid: uid,\r\n          parentId: null\r\n        })\r\n        this.$message.success('评论成功')\r\n        this.commentContent = ''\r\n        this.showCommentInput = false\r\n        this.$store.commit('SET_UID', uid)\r\n        this.fetchDetail()\r\n      } catch (e) {\r\n        this.$message.error(e.message || '评论失败')\r\n      } finally {\r\n        this.submitting = false\r\n      }\r\n    },\r\n    openReply(comment, reply) {\r\n      this.replyTarget = reply || comment\r\n      this.replyContent = ''\r\n    },\r\n    async submitReply(comment) {\r\n      const uid = this.currentUid || this.commentUid\r\n      if (!uid) {\r\n        this.$message.warning('请输入用户UID')\r\n        return\r\n      }\r\n      if (!this.replyContent.trim()) {\r\n        this.$message.warning('请输入回复内容')\r\n        return\r\n      }\r\n      this.submitting = true\r\n      try {\r\n        await publishComment({\r\n          messageId: this.message.id,\r\n          content: this.replyContent,\r\n          uid: uid,\r\n          parentI