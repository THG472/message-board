      }))();\n    },\n    scrollToComment: function scrollToComment() {\n      var box = this.$refs.commentBox;\n      if (box) {\n        box.scrollIntoView({\n          behavior: 'smooth',\n          block: 'start'\n        });\n        this.$nextTick(function () {\n          var textarea = box.querySelector('textarea');\n          if (textarea) textarea.focus();\n        });\n      }\n    },\n    handleLike: function handleLike() {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        var liked, _t2;\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.p = _context2.n) {\n            case 0:\n              if (_this2.currentUid) {\n                _context2.n = 1;\n                break;\n              }\n              _this2.$message.warning('请通过正确的链接访问系统');\n              return _context2.a(2);\n            case 1:\n              _context2.p = 1;\n              _context2.n = 2;\n              return toggleLike(_this2.message.id);\n            case 2:\n              liked = _context2.v;\n              _this2.message.liked = liked;\n              _this2.message.likeCount += liked ? 1 : -1;\n              _context2.n = 4;\n              break;\n            case 3:\n              _context2.p = 3;\n              _t2 = _context2.v;\n              _this2.$message.error('操作失败');\n            case 4:\n              return _context2.a(2);\n          }\n        }, _callee2, null, [[1, 3]]);\n      }))();\n    },\n    submitComment: function submitComment() {\n      var _this3 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3() {\n        var _t3;\n        return _regenerator().w(function (_context3) {\n          while (1) switch (_context3.p = _context3.n) {\n            case 0:\n              if (_this3.commentContent.trim()) {\n                _context3.n = 1;\n                break;\n              }\n              return _context3.a(2);\n            case 1:\n              _this3.submitting = true;\n              _context3.p = 2;\n              _context3.n = 3;\n              return publishComment({\n                messageId: _this3.message.id,\n                content: _this3.commentContent,\n                parentId: null\n              });\n            case 3:\n              _this3.$message.success('评论成功');\n              _this3.commentContent = '';\n              _this3.fetchDetail();\n              _context3.n = 5;\n              break;\n            case 4:\n              _context3.p = 4;\n              _t3 = _context3.v;\n              _this3.$message.error(_t3.message || '评论失败');\n            case 5:\n              _context3.p = 5;\n              _this3.submitting = false;\n              return _context3.f(5);\n            case 6:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[2, 4, 5, 6]]);\n      }))();\n    },\n    openReply: function openReply(comment, reply) {\n      this.replyTarget = reply || comment;\n      this.replyContent = '';\n      this.$nextTick(function () {\n        var box = document.querySelector('.reply-input-box textarea');\n        if (box) box.focus();\n      });\n    },\n    submitReply: function submitReply(comment) {\n      var _this4 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee4() {\n        var _t4;\n        return _regenerator().w(function (_context4) {\n          while (1) switch (_context4.p = _context4.n) {\n            case 0:\n              if (_this4.replyContent.trim()) {\n                _context4.n = 1;\n                break;\n              }\n              return _context4.a(2);\n            case 1:\n              _this4.submitting = true;\n              _context4.p = 2;\n              _context4.n = 3;\n              return publishComment({\n                messageId: _this4.message.id,\n                content: _this4.replyContent,\n                parentId: comment.id,\n                replyToUid: _this4.replyTarget ? _this4.replyTarget.uid : comment.uid\n              });\n            case 3:\n              _this4.$message.success('回复成功');\n              _this4.replyTarget = null;\n              _this4.replyContent = '';\n              _this4.fetchDetail();\n              _context4.n = 5;\n              break;\n            case 4:\n              _context4.p = 4;\n              _t4 = _context4.v;\n              _this4.$message.error(_t4.message || '回复失败');\n            case 5:\n              _context4.p = 5;\n              _this4.submitting = false;\n              return _context4.f(5);\n            case 6:\n              return _context4.a(2);\n          }\n        }, _callee4, null, [[2, 4, 5, 6]]);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["getMessageDetail","toggleLike","publishComment","mapState","name","data","message","loading","commentContent","replyTarget","replyContent","submitting","computed","_objectSpread","created","fetchDetail","methods","_this","_asyncToGenerator","_regenerator","m","_callee","_t","w","_context","p","n","$route","params","id","v","$message","error","f","a","scrollToComment","box","$refs","commentBox","scrollIntoView","behavior","block","$nextTick","textarea","querySelector","focus","handleLike","_this2","_callee2","liked","_t2","_context2","currentUid","warning","likeCount","submitComment","_this3","_callee3","_t3","_context3","trim","messageId","content","parentId","success","openReply","comment","reply","document","submitReply","_this4","_callee4","_t4","_context4","replyToUid","uid"],"sources":["src/views/MessageDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"detail-page\">\r\n    <div class=\"detail-breadcrumb\">\r\n      <el-button icon=\"el-icon-arrow-left\" @click=\"$router.push('/')\" size=\"medium\" plain>返回留言列表</el-button>\r\n    </div>\r\n\r\n    <div v-loading=\"loading\" class=\"detail-content-area\" element-loading-text=\"加载中...\">\r\n      <!-- 留言详情 -->\r\n      <div class=\"detail-card\">\r\n        <div class=\"detail-header\">\r\n          <span class=\"detail-category\" :class=\"message.category\">\r\n            {{ message.category === 'question' ? '问题反馈' : '需求建议' }}\r\n          </span>\r\n          <h1 class=\"detail-title\">{{ message.title }}</h1>\r\n        </div>\r\n        <div class=\"detail-meta\">\r\n          <span class=\"meta-user\">\r\n            <span class=\"meta-avatar\">{{ message.userName ? message.userName.charAt(0) : '?' }}</span>\r\n            <strong>{{ message.userName }}</strong>\r\n            <span v-if=\"message.orgName\" class=\"meta-org\">{{ message.orgName }}</span>\r\n          </span>\r\n          <span class=\"meta-divider\">|</span>\r\n          <span class=\"meta-time\">发布于 {{ message.createTime }}</span>\r\n        </div>\r\n        <div class=\"detail-body\">{{ message.content }}</div>\r\n        <div class=\"detail-actions\">\r\n          <div class=\"action-btn\" :class=\"{ active: message.liked }\" @click=\"handleLike\">\r\n            <i :class=\"message.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\r\n            <span>{{ message.liked ? '已点赞' : '点赞' }}</span>\r\n            <em>{{ message.likeCount }}</em>\r\n          </div>\r\n          <div class=\"action-btn\" @click=\"scrollToComment\">\r\n            <i class=\"el-icon-chat-dot-round\"></i>\r\n            <span>评论</span>\r\n            <em>{{ message.commentCount }}</em>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 评论输入框 -->\r\n      <div class=\"comment-input-card\" ref=\"commentBox\">\r\n        <div class=\"comment-input-title\">发表评论</div>\r\n        <el-input\r\n          v-model=\"commentContent\"\r\n          type=\"textarea\"\r\n          :rows=\"3\"\r\n          placeholder=\"写下你的想法...\"\r\n          resize=\"none\"\r\n        />\r\n        <div class=\"comment-input-footer\">\r\n          <span class=\"input-tip\">支持友善交流，文明发言</span>\r\n          <el-button type=\"primary\" @click=\"submitComment\" :loading=\"submitting\" size=\"medium\" :disabled=\"!commentContent.trim()\">发表评论</el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 评论列表 -->\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-section-header\">\r\n          <h3>全部评论 <span class=\"comment-total\">{{ message.commentCount }}</span></h3>\r\n        </div>\r\n        <el-empty v-if=\"!loading && (!message.comments || message.comments.length === 0)\" description=\"还没有评论，快来抢沙发吧\" :image-size=\"100\" />\r\n        <div v-for=\"comment in message.comments\" :key=\"comment.id\" class=\"comment-item\">\r\n          <div class=\"comment-avatar\">{{ comment.userName ? comment.userName.charAt(0) : '?' }}</div>\r\n          <div class=\"comment-body\">\r\n            <div class=\"comment-header\">\r\n              <span class=\"comment-user-name\">{{ comment.userName }}</span>\r\n              <span v-if=\"comment.orgName\" class=\"comment-org\">{{ comment.orgName }}</span>\r\n              <span class=\"comment-time\">{{ comment.createTime }}</span>\r\n            </div>\r\n            <div class=\"comment-text\">{{ comment.content }}</div>\r\n            <div class=\"comment-actions\">\r\n              <span class=\"comment-action-btn\" @click=\"openReply(comment)\">\r\n                <i class=\"el-icon-chat-line-square\"></i> 回复\r\n              </span>\r\n            </div>\r\n            <!-- 回复输入框 -->\r\n            <div v-if=\"replyTarget && replyTarget.id === comment.id\" class=\"reply-input-box\">\r\n              <el-input\r\n                v-model=\"replyContent\"\r\n                type=\"textarea\"\r\n                :rows=\"2\"\r\n                :placeholder=\"'回复 ' + comment.userName + '...'\"\r\n                resize=\"none\"\r\n              />\r\n              <div class=\"reply-input-footer\">\r\n                <span class=\"reply-to-hint\">回复 @{{ comment.userName }}</span>\r\n                <div>\r\n                  <el-button size=\"small\" @click=\"replyTarget = null\">取消</el-button>\r\n                  <el-button type=\"primary\" size=\"small\" @click=\"submitReply(comment)\" :loading=\"submitting\">回复</el-button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <!-- 子回复 -->\r\n            <div v-if=\"comment.replies && comment.replies.length > 0\" class=\"sub-comments\">\r\n              <div v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"sub-comment-item\">\r\n                <span class=\"sub-avatar\">{{ reply.userName ? reply.userName.charAt(0) : '?' }}</span>\r\n                <div class=\"sub-comment-body\">\r\n                  <div class=\"sub-comment-header\">\r\n                    <span class=\"sub-user-name\">{{ reply.userName }}</span>\r\n                    <span v-if=\"reply.replyToName\" class=\"sub-reply-to\">\r\n                      <i class=\"el-icon-caret-right\"></i> {{ reply.replyToName }}\r\n                    </span>\r\n                    <span class=\"sub-time\">{{ reply.createTime }}</span>\r\n                  </div>\r\n                  <div class=\"sub-comment-text\">{{ reply.content }}</div>\r\n                  <span class=\"comment-action-btn sub-action\" @click=\"openReply(comment, reply)\">\r\n                    <i class=\"el-icon-chat-line-square\"></i> 回复\r\n                  </span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMessageDetail, toggleLike, publishComment } from '../api'\r\nimport { mapState } from 'vuex'\r\n\r\nexport default {\r\n  name: 'MessageDetail',\r\n  data() {\r\n    return {\r\n      message: {},\r\n      loading: false,\r\n      commentContent: '',\r\n      replyTarget: null,\r\n      replyContent: '',\r\n      submitting: false\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState(['currentUid'])\r\n  },\r\n  created() {\r\n    this.fetchDetail()\r\n  },\r\n  methods: {\r\n    async fetchDetail() {\r\n      this.loading = true\r\n      try {\r\n        this.message = await getMessageDetail(this.$route.params.id)\r\n      } catch (e) {\r\n        this.$message.error('加载详情失败')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    scrollToComment() {\r\n      const box = this.$refs.commentBox\r\n      if (box) {\r\n        box.scrollIntoView({ behavior: 'smooth', block: 'start' })\r\n        this.$nextTick(() => {\r\n          const textarea = box.querySelector('textarea')\r\n          if (textarea) textarea.focus()\r\n        })\r\n      }\r\n    },\r\n    async handleLike() {\r\n      if (!this.currentUid) {\r\n        this.$message.warning('请通过正确的链接访问系统')\r\n        return\r\n      }\r\n      try {\r\n        const liked = await toggleLike(this.message.id)\r\n        this.message.liked = liked\r\n        this.message.likeCount += liked ? 1 : -1\r\n      } catch (e) {\r\n        this.$message.error('操作失败')\r\n      }\r\n    },\r\n    async submitComment() {\r\n      if (!this.commentContent.trim()) return\r\n      this.submitting = true\r\n      try {\r\n        await publishComment({\r\n          messageId: this.message.id,\r\n          content: this.commentContent,\r\n          parentId: null\r\n        })\r\n        this.$message.success('评论成功')\r\n        this.commentContent = ''\r\n        this.fetchDetail()\r\n      } catch (e) {\r\n        this.$message.error(e.message || '评论失败')\r\n      } finally {\r\n        this.submitting = false\r\n      }\r\n    },\r\n    openReply(comment, reply) {\r\n      this.replyTarget = reply || comment\r\n      this.replyContent = ''\r\n      this.$nextTick(() => {\r\n        const box = document.querySelector('.reply-input-box textarea')\r\n        if (box) box.focus()\r\n      })\r\n    },\r\n    async submitReply(comment) {\r\n      if (!this.replyContent.trim()) return\r\n      this.submitting = true\r\n      try {\r\n        await publishComment({\r\n          messageId: this.message.id,\r\n          content: this.replyContent,\r\n          parentId: comment.id,\r\n          replyToUid: this.replyTarget ? this.replyTarget.uid : comment.uid\r\n        })\r\n        this.$message.success('回复成功')\r\n        this.replyTarget = null\r\n        this.replyContent = ''\r\n        this.fetchDetail()\r\n      } catch (e) {\r\n        this.$message.error(e.message || '回复失败')\r\n      } finally {\r\n        this.submitting = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.detail-page {\r\n  max-width: 960px;\r\n  margin: 0 auto;\r\n}\r\n\r\n/* ========== 面包屑 ========== */\r\n.detail-breadcrumb {\r\n  margin-bottom: 24px;\r\n}\r\n\r\n/* ========== 详情卡片 ========== */\r\n.detail-card {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  padding: 32px;\r\n  margin-bottom: 24px;\r\n  box-shadow: 0 2px 12px rgba(0,0,0,0.04);\r\n}\r\n.detail-header {\r\n  margin-bottom: 16px;\r\n}\r\n.detail-category {\r\n  display: inline-block;\r\n  padding: 4px 14px;\r\n  border-radius: 4px;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  margin-bottom: 14px;\r\n}\r\n.detail-category.question {\r\n  background: #fef0f0;\r\n  color: #f56c6c;\r\n}\r\n.detail-category.requirement {\r\n  background: #f0f9eb;\r\n  color: #67c23a;\r\n}\r\n.detail-title {\r\n  font-size: 24px;\r\n  font-weight: 700;\r\n  color: #1d2129;\r\n  line-height: 1.4;\r\n}\r\n.detail-meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  color: #86909c;\r\n  font-size: 14px;\r\n  margin-bottom: 28px;\r\n  padding-bottom: 24px;\r\n  border-bottom: 1px solid #f2f3f5;\r\n}\r\n.meta-user {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n.meta-avatar {\r\n  width: 30px;\r\n  height: 30px;\r\n  border-radius: 50%;\r\n  background: linear-gradient(135deg, #409EFF, #337ECC);\r\n  color: #fff;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n.meta-org {\r\n  color: #c9cdd4;\r\n  font-size: 13px;\r\n}\r\n.meta-divider {\r\n  color: #e5e6eb;\r\n}\r\n.meta-time {\r\n  color: #c9cdd4;\r\n}\r\n.detail-body {\r\n  font-size: 16px;\r\n  color: #1d2129;\r\n  line-height: 1.9;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n.detail-actions {\r\n  display: flex;\r\n  gap: 16px;\r\n  margin-top: 32px;\r\n  padding-top: 24px;\r\n  border-top: 1px solid #f2f3f5;\r\n}\r\n.action-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 10px 20px;\r\n  border-radius: 8px;\r\n  background: #f7f8fa;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n  font-size: 14px;\r\n  color: #4e5969;\r\n  user-select: none;\r\n}\r\n.action-btn:hover {\r\n  background: #e8f3ff;\r\n  color: #409EFF;\r\n}\r\n.action-btn.active {\r\n  background: #fef0f0;\r\n  color: #f56c6c;\r\n}\r\n.action-btn i {\r\n  font-size: 18px;\r\n}\r\n.action-btn em {\r\n  font-style: normal;\r\n  font-weight: 700;\r\n  margin-left: 2px;\r\n}\r\n\r\n/* ========== 评论输入 ========== */\r\n.comment-input-card {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  padding: 24px;\r\n  margin-bottom: 24px;\r\n  box-shadow: 0 2px 12px rgba(0,0,0,0.04);\r\n}\r\n.comment-input-title {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #1d2129;\r\n  margin-bottom: 14px;\r\n}\r\n.comment-input-footer {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 14px;\r\n}\r\n.input-tip {\r\n  font-size: 12px;\r\n  color: #c9cdd4;\r\n}\r\n\r\n/* ========== 评论列表 ========== */\r\n.comment-section {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  padding: 28px 32px;\r\n  box-shadow: 0 2px 12px rgba(0,0,0,0.04);\r\n}\r\n.comment-section-header {\r\n  margin-bottom: 24px;\r\n}\r\n.comment-section-header h3 {\r\n  font-size: 17px;\r\n  font-weight: 600;\r\n  color: #1d2129;\r\n}\r\n.comment-total {\r\n  color: #409EFF;\r\n  font-size: 15px;\r\n}\r\n.comment-item {\r\n  display: flex;\r\n  padding: 20px 0;\r\n  border-bottom: 1px solid #f2f3f5;\r\n}\r\n.comment-item:last-child {\r\n  border-bottom: none;\r\n  padding-bottom: 0;\r\n}\r\n.comment-avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  background: linear-gradient(135deg, #409EFF, #337ECC);\r\n  color: #fff;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  flex-shrink: 0;\r\n  margin-right: 14px;\r\n}\r\n.comment-body {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n.comment-header {\r\n  margin-bottom: 6px;\r\n}\r\n.comment-user-name {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: #1d2129;\r\n}\r\n.comment-org {\r\n  font-size: 12px;\r\n  color: #c9cdd4;\r\n  margin-left: 6px;\r\n}\r\n.comment-time {\r\n  font-size: 12px;\r\n  color: #c9cdd4;\r\n  margin-left: 12px;\r\n}\r\n.comment-text {\r\n  font-size: 14px;\r\n  color: #4e5969;\r\n  line-height: 1.7;\r\n  margin-bottom: 8px;\r\n  word-break: break-word;\r\n}\r\n.comment-actions {\r\n  display: flex;\r\n  gap: 16px;\r\n}\r\n.comment-action-btn {\r\n  font-size: 12px;\r\n  color: #86909c;\r\n  cursor: pointer;\r\n  transition: color 0.2s;\r\n}\r\n.comment-action-btn:hover {\r\n  color: #409EFF;\r\n}\r\n.sub-action {\r\n  margin-top: 4px;\r\n  display: inline-block;\r\n}\r\n.reply-input-box {\r\n  margin-top: 12px;\r\n}\r\n.reply-input-footer {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 10px;\r\n}\r\n.reply-to-hint {\r\n  font-size: 12px;\r\n  color: #c9cdd4;\r\n}\r\n\r\n/* ========== 子回复 ========== */\r\n.sub-comments {\r\n  margin-top: 14px;\r\n  padding: 16px 20px;\r\n  background: #f7f8fa;\r\n  border-radius: 8px;\r\n}\r\n.sub-comment-item {\r\n  display: flex;\r\n  padding: 8px 0;\r\n}\r\n.sub-comment-item + .sub-comment-item {\r\n  border-top: 1px dashed #e5e6eb;\r\n}\r\n.sub-avatar {\r\n  width: 28px;\r\n  hei