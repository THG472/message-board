 }}）</span>\r\n        <span class=\"meta-divider\">|</span>\r\n        <span>{{ message.createTime }}</span>\r\n      </div>\r\n      <div class=\"detail-content\">{{ message.content }}</div>\r\n      <div class=\"detail-actions\">\r\n        <el-button\r\n          :type=\"message.liked ? 'danger' : 'default'\"\r\n          :icon=\"message.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"\r\n          size=\"small\"\r\n          @click=\"handleLike\"\r\n          :disabled=\"!currentUid\"\r\n        >\r\n          点赞 {{ message.likeCount }}\r\n        </el-button>\r\n        <el-button type=\"primary\" icon=\"el-icon-edit\" size=\"small\" @click=\"showCommentInput = true\" :disabled=\"!currentUid\">\r\n          评论 {{ message.commentCount }}\r\n        </el-button>\r\n      </div>\r\n    </el-card>\r\n\r\n    <!-- 评论输入框 -->\r\n    <div v-if=\"showCommentInput\" class=\"comment-input-box\">\r\n      <el-input\r\n        v-model=\"commentContent\"\r\n        type=\"textarea\"\r\n        :rows=\"3\"\r\n        placeholder=\"写下你的评论...\"\r\n      />\r\n      <div class=\"comment-input-actions\">\r\n        <el-button @click=\"showCommentInput = false\">取消</el-button>\r\n        <el-button type=\"primary\" @click=\"submitComment\" :loading=\"submitting\">发表评论</el-button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 评论列表 -->\r\n    <div class=\"comment-section\">\r\n      <h3 v-if=\"message.comments && message.comments.length > 0\">评论 ({{ message.commentCount }})</h3>\r\n      <div v-for=\"comment in message.comments\" :key=\"comment.id\" class=\"comment-item\">\r\n        <div class=\"comment-avatar\">{{ comment.userName.charAt(0) }}</div>\r\n        <div class=\"comment-body\">\r\n          <div class=\"comment-user\">\r\n            <strong>{{ comment.userName }}</strong>\r\n            <span v-if=\"comment.orgName\" class=\"org\">（{{ comment.orgName }}）</span>\r\n            <span class=\"comment-time\">{{ comment.createTime }}</span>\r\n          </div>\r\n          <div class=\"comment-text\">{{ comment.content }}</div>\r\n          <div class=\"comment-reply-btn\">\r\n            <el-button type=\"text\" size=\"mini\" @click=\"openReply(comment)\">回复</el-button>\r\n          </div>\r\n          <!-- 回复输入框 -->\r\n          <div v-if=\"replyTarget && replyTarget.id === comment.id\" class=\"reply-input-box\">\r\n            <el-input\r\n              v-model=\"replyContent\"\r\n              type=\"textarea\"\r\n              :rows=\"2\"\r\n              :placeholder=\"'回复 ' + comment.userName\"\r\n            />\r\n            <div class=\"reply-actions\">\r\n              <el-button size=\"mini\" @click=\"replyTarget = null\">取消</el-button>\r\n              <el-button type=\"primary\" size=\"mini\" @click=\"submitReply(comment)\" :loading=\"submitting\">回复</el-button>\r\n            </div>\r\n          </div>\r\n          <!-- 子回复 -->\r\n          <div v-if=\"comment.replies && comment.replies.length > 0\" class=\"sub-comments\">\r\n            <div v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"sub-comment-item\">\r\n              <span class=\"reply-avatar\">{{ reply.userName.charAt(0) }}</span>\r\n              <div class=\"sub-comment-body\">\r\n                <span class=\"sub-comment-user\">\r\n                  <strong>{{ reply.userName }}</strong>\r\n                  <span v-if=\"reply.replyToName\" class=\"reply-to\">\r\n                    回复 <strong>{{ reply.replyToName }}</strong>\r\n                  </span>\r\n                </span>\r\n                <span class=\"comment-time\">{{ reply.createTime }}</span>\r\n                <div class=\"comment-text\">{{ reply.content }}</div>\r\n                <el-button type=\"text\" size=\"mini\" @click=\"openReply(comment, reply)\">回复</el-button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <el-empty v-if=\"!loading && (!message.comments || message.comments.length === 0)\" description=\"暂无评论\" />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getMessageDetail, toggleLike, publishComment } from '../api'\r\nimport { mapState } from 'vuex'\r\n\r\nexport default {\r\n  name: 'MessageDetail',\r\n  data() {\r\n    return {\r\n      message: {},\r\n      loading: false,\r\n      showCommentInput: false,\r\n      commentContent: '',\r\n      replyTarget: null,\r\n      replyContent: '',\r\n      submitting: false\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState(['currentUid'])\r\n  },\r\n  created() {\r\n    this.fetchDetail()\r\n  },\r\n  methods: {\r\n    async fetchDetail() {\r\n      this.loading = true\r\n      try {\r\n        this.message = await getMessageDetail(this.$route.params.id)\r\n      } catch (e) {\r\n        this.$message.error('加载详情失败')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async handleLike() {\r\n      if (!this.currentUid) {\r\n        this.$message.warning('请通过正确的链接访问系统')\r\n        return\r\n      }\r\n      try {\r\n        const liked = await toggleLike(this.message.id)\r\n        this.message.liked = liked\r\n        this.message.likeCount += liked ? 1 : -1\r\n        this.$message.success(liked ? '点赞成功' : '已取消点赞')\r\n      } catch (e) {\r\n        this.$message.error('操作失败')\r\n      }\r\n    },\r\n    async submitComment() {\r\n      if (!this.commentContent.trim()) {\r\n        this.$message.warning('请输入评论内容')\r\n        return\r\n      }\r\n      this.submitting = true\r\n      try {\r\n        await publishComment({\r\n          messageId: this.message.id,\r\n          content: this.commentContent,\r\n          parentId: null\r\n        })\r\n        this.$message.success('评论成功')\r\n        this.commentContent = ''\r\n        this.showCommentInput = false\r\n        this.fetchDetail()\r\n      } catch (e) {\r\n        this.$message.error(e.message || '评论失败')\r\n      } finally {\r\n        this.submitting = false\r\n      }\r\n    },\r\n    openReply(comment, reply) {\r\n      this.replyTarget = reply || comment\r\n      this.replyContent = ''\r\n    },\r\n    async submitReply(comment) {\r\n      if (!this.replyContent.trim()) {\r\n        this.$message.warning('请输入回复内容')\r\n        return\r\n      }\r\n      this.submitting = true\r\n      try {\r\n        await publishComment({\r\n          messageId: this.message.id,\r\n          content: this.replyContent,\r\n          parentId: comment.id,\r\n          replyToUid: this.replyTarget ? this.replyTarget.uid : comment.uid\r\n        })\r\n        this.$message.success('回复成功')\r\n        this.replyTarget = null\r\n        this.replyContent = ''\r\n        this.fetchDetail()\r\n      } catch (e) {\r\n        this.$message.error(e.message || '回复失败')\r\n      } finally {\r\n        this.submitting = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.detail-page {\r\n  max-width: 1000px;\r\n  margin: 0 auto;\r\n}\r\n.back-btn {\r\n  margin-bottom: 16px;\r\n}\r\n.detail-card {\r\n  border-radius: 8px;\r\n  margin-bottom: 16px;\r\n}\r\n.detail-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin-bottom: 12px;\r\n}\r\n.detail-title {\r\n  font-size: 20px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n}\r\n.detail-meta {\r\n  color: #909399;\r\n  font-size: 13px;\r\n  margin-bottom: 16px;\r\n}\r\n.meta-divider {\r\n  margin: 0 8px;\r\n}\r\n.detail-content {\r\n  color: #606266;\r\n  line-height: 1.8;\r\n  margin-bottom: 20px;\r\n  white-space: pre-wrap;\r\n}\r\n.detail-actions {\r\n  border-top: 1px solid #f0f0f0;\r\n  padding-top: 15px;\r\n}\r\n.comment-input-box {\r\n  margin-bottom: 16px;\r\n  background: #fff;\r\n  padding: 16px;\r\n  border-radius: 8px;\r\n}\r\n.comment-input-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  align-items: center;\r\n  gap: 10px;\r\n  margin-top: 10px;\r\n}\r\n.comment-section {\r\n  background: #fff;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n}\r\n.comment-section 